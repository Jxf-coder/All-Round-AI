{
  "name": "all-round-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "portable/packages/*"
  ],
  "scripts": {
    "start": "node portable/apps/runtime/src/main.mjs",
    "account:create": "node portable/apps/runtime/src/accounts-cli.mjs",
    "backup": "node portable/apps/runtime/src/backup-cli.mjs create",
    "backup:verify": "node portable/apps/runtime/src/backup-cli.mjs verify",
    "backup:restore": "node portable/apps/runtime/src/backup-cli.mjs restore",
    "deploy:systemd": "node portable/apps/runtime/src/deploy-cli.mjs systemd",
    "update": "node portable/apps/runtime/src/update-cli.mjs",
    "test": "node --test \"portable/packages/platform/test/*.test.mjs\" \"portable/apps/runtime/test/*.test.mjs\"",
    "test:platform": "node --test \"portable/packages/platform/test/*.test.mjs\" \"portable/apps/runtime/test/*.test.mjs\""
  }
}
